        <!-- ================= note + legend ================= -->
        <mxCell id="rj_note" value="Both callbacks run on the same physical background thread as every other symbol's &#8212; ibapi's EClient.run() message-processing&lt;br&gt;loop, shared across all 54 subscriptions. open_trades / live_bars are dicts keyed by symbol so one pair of callbacks&lt;br&gt;serves every symbol; see action_gluptasek for the single-symbol version of this same pattern." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
