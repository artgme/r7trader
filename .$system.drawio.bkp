        <mxCell id="rj_b3b" value="open_trades[symbol] = {direction, entry_price,&lt;br&gt;entry_time, entry_order_id, trail_stop_loss, take_profit_pct,&lt;br&gt;extreme, bars_since_check: 0}" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
