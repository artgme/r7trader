        </mxCell>
        <mxCell id="rj_a4" value="register on_error(_on_ibkr_error)&lt;br&gt;init_trade_log(); init_signal_log()&lt;br&gt;on_fill(make_fill_handler); on_fill(_on_fill)&lt;br&gt;&#8212; detects exit fills, incl. CLOSE_OVERNIGHT closes" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="345" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rj_a5" value="open_trades = {}; live_bars = {sym: deque(maxlen=12)&lt;br&gt;for sym in SYMBOLS}; symbol_by_req_id = {}&lt;br&gt;on_realtime_bar(_on_realtime_bar)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
