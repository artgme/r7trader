        </mxCell>
        <mxCell id="rj_c5" value="tp_time, tp_price = scan_take_profit(window_df, entry_time,&lt;br&gt;entry_price, direction, take_profit_pct)&lt;br&gt;if tp_price: pending_closes.add(symbol) &amp; return  (TP wins the tick;&lt;br&gt;NOT closed here — see note below)&lt;br&gt;else: extreme, exit_time, exit_price =&lt;br&gt;scan_trailing_stop(window_df, entry_time, entry_price,&lt;br&gt;direction, trail_stop_loss, extreme=trade['extreme'])" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
