        <mxCell id="rj_c7" value="pending_closes.add(symbol)&lt;br&gt;[actual close + broker-TRAIL cancel happens&lt;br&gt;later, in the main loop — see note]" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
