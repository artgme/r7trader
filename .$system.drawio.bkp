        <mxCell id="wz_be7" value="[no] still open" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_bd2" target="wz_bx3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_be8" value="[yes] stop hit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_bd2" target="wz_b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_be9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_b4" target="wz_bx2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_cstart" target="wz_c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_c1" target="wz_cd1"><mxGeometry relative="1" as="geometry" /></mxCell>
