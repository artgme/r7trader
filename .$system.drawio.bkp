        <mxCell id="rj_b3" value="result = execute_trade(gw, symbol, signal,&lt;br&gt;contracts[symbol], QUANTITY, trail_stop_loss,&lt;br&gt;FILL_TIMEOUT, positions)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
