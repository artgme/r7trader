        <mxCell id="rj_c6" value="trade['extreme'] = extreme" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1020" y="715" width="280" height="50" as="geometry" />
