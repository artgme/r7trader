        <!-- ================= note + legend ================= -->
        <mxCell id="gp_note" value="Both callbacks above run on the same physical background thread &#8212; ibapi's EClient.run() message&#8211;processing&lt;br&gt;loop (see the sequence diagram / earlier discussion). They're drawn as two separate flows here because they're&lt;br&gt;triggered by two different events, not because they execute concurrently with each other." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
