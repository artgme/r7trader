        <!-- ================= LANE B: _on_realtime_bar ================= -->
        <mxCell id="wz_b_lbl" value="_on_realtime_bar(reqId, bar)  &#8212; fires every ~5s per subscribed symbol" style="text;html=1;fontSize=12;fontStyle=34;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="980" y="46" width="580" height="20" as="geometry" />
        </mxCell>
        <mxCell id="wz_bstart" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1248" y="80" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="wz_b1" value="symbol = symbol_by_req_id.get(reqId)&#160;&#8212; return if unknown&lt;br&gt;(a bar from a session that has since unsubscribed)&lt;br&gt;live_bars[symbol].append(bar)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1060" y="130" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_bd1" value="symbol in open_trades?&lt;br&gt;bars_since_check &#8805; 12?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1090" y="205" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wz_bx1" value="X" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="228" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="wz_b2" value="window_df &#8592; last 12 bars of live_bars[symbol]" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1060" y="300" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wz_b3" value="tp_time, tp_price = scan_take_profit(window_df, entry_time,&lt;br&gt;entry_price, direction, take_profit_pct)&lt;br&gt;if tp_price: pending_closes.add(symbol) &amp; return&lt;br&gt;else: extreme, exit_time, exit_price = scan_trailing_stop(...)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1040" y="375" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="wz_bd2" value="exit_price is not None?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="485" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wz_b4" value="pending_closes.add(symbol)&lt;br&gt;&lt;i&gt;flag only &#8212; never closes directly (see note)&lt;/i&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="580" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_bx2" value="X" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1248" y="670" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="wz_bx3" value="X" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1450" y="503" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- ================= LANE B: _on_fill ================= -->
        <mxCell id="wz_c_lbl" value="_on_fill(trade, fill)  &#8212; fires on every order fill (entry, TRAIL, or a flatten close)" style="text;html=1;fontSize=12;fontStyle=34;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="980" y="760" width="580" height="20" as="geometry" />
        </mxCell>
        <mxCell id="wz_cstart" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1248" y="795" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="wz_c1" value="log FILL: side, shares, symbol, price, orderId" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1060" y="845" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wz_cd1" value="open_trades has symbol &lt;b&gt;and&lt;/b&gt;&lt;br&gt;fill.orderId &#8800; entry_order_id?&lt;br&gt;&lt;i&gt;(an exit fill &#8212; TRAIL, TP or flatten)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1080" y="920" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wz_c2" value="del open_trades[symbol]&lt;br&gt;&lt;i&gt;stops the client-side checks for it&lt;/i&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1050" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_cx1" value="X" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1248" y="1140" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="wz_cx2" value="X" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="953" width="24" height="24" as="geometry" />
