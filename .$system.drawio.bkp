        <mxCell id="rj_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rj_a1" target="rj_d1"><mxGeometry relative="1" as="geometry" /></mxCell>
