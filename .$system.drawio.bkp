        </mxCell>

        <mxCell id="rj_b1" value="get per-symbol params (vol_len, vol_multiplier,&lt;br&gt;price_move_pct, trail_stop_pct, body_ratio_threshold)&lt;br&gt;take_profit_pct = trail_stop_loss × TAKE_PROFIT_RR&lt;br&gt;df = fetch_data_from_IBKR(...); update_current_price()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
