        <mxCell id="rj_a3" value="po.start_dashboard()&lt;br&gt;po.sync_with_ibkr(gw.get_positions())" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
