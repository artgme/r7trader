        <mxCell id="rj_c4" value="window_df &#8592; last 12&lt;br&gt;live_bars[symbol]" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
