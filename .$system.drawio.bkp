  <diagram id="wz_action_wedrownyzbysio_01" name="action_wedrownyZbysio">
    <mxGraphModel dx="2040" dy="1258" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="2850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="wz_title" value="wedrownyZbysio.py &#8212; activity diagram: main() trading EU / US / Asia sessions, each on its own clock" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-46" width="1200" height="30" as="geometry" />
        </mxCell>

        <!-- ================= lane backgrounds ================= -->
        <mxCell id="wz_laneA" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="880" height="2800" as="geometry" />
        </mxCell>
        <mxCell id="wz_laneA_lbl" value="main() &#8212; setup &amp; the per-session sweep  (main thread)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="8" width="760" height="20" as="geometry" />
        </mxCell>
        <mxCell id="wz_laneB" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="960" y="0" width="620" height="2800" as="geometry" />
        </mxCell>
        <mxCell id="wz_laneB_lbl" value="background IBKR callback thread  (on_realtime_bar / on_fill &#8212; all sessions share it)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="980" y="8" width="580" height="20" as="geometry" />
        </mxCell>

        <!-- ================= reference notes ================= -->
        <mxCell id="wz_note_phase" value="&lt;b&gt;session_phase(session, now, bar_seconds)&lt;/b&gt;&lt;br&gt;the one place that decides what may happen &#8212; pure,&lt;br&gt;testable without IBKR:&lt;br&gt;&#160;&lt;br&gt;&lt;b&gt;closed&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;no poll, no subscription&lt;br&gt;&lt;b&gt;warmup&lt;/b&gt;&#160;&#160;&#160;&#160;poll + log, no entries (1st bar forming)&lt;br&gt;&lt;b&gt;trading&lt;/b&gt;&#160;&#160;&#160;entries allowed&lt;br&gt;&lt;b&gt;wind_down&lt;/b&gt;&#160;poll + log, keep managing open positions,&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;no NEW entries (last NO_ENTRY_BARS_&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;BEFORE_FLATTEN bars before the flatten)&lt;br&gt;&lt;b&gt;flatten&lt;/b&gt;&#160;&#160;&#160;flatten once, then nothing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="wz_note_overlap" value="&lt;b&gt;Sessions are independent, not sequential.&lt;/b&gt;&lt;br&gt;There is no single &quot;current session&quot; to switch to &#8212;&lt;br&gt;the sweep services every session that has work:&lt;br&gt;&#160;&lt;br&gt;winter&#160;&#160;14:30Z&#160;US=warmup&#160;&#160;EU=trading&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;16:00Z&#160;US=trading&#160;EU=flatten&lt;br&gt;summer&#160;07:00Z&#160;EU=warmup&#160;&#160;ASIA=trading&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;07:30Z&#160;EU=trading&#160;ASIA=flatten&lt;br&gt;&#160;&lt;br&gt;DST is handled by each Session's own ZoneInfo &#8212;&lt;br&gt;US and EU switch on different dates, HK never does." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="550" width="290" height="175" as="geometry" />
        </mxCell>
        <mxCell id="wz_note_pending" value="&lt;b&gt;Why the close happens HERE&lt;/b&gt; and not in Lane B:&lt;br&gt;Lane B runs on ibapi's single message-dispatch thread.&lt;br&gt;A blocking gw.close_position() called from there can&lt;br&gt;never receive its own response (that same thread would&lt;br&gt;have to read it) &#8212; it times out after 10s and reports a&lt;br&gt;false &quot;No open position&quot;. So Lane B only ever flags." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="985" width="290" height="105" as="geometry" />
        </mxCell>

        <!-- ================= LANE A: setup ================= -->
        <mxCell id="wz_start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="388" y="50" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="wz_a1" value="gw = IBKRGateway(client_id=CLIENT_ID)&lt;br&gt;ensure_connected()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_d1" value="connected?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="190" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_a2" value="log &#8216;Could not connect to IBKR&#8217;&lt;br&gt;return" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_end1_o" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="668" y="270" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="wz_end1_i" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="674" y="276" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="wz_a3" value="po.start_dashboard()&lt;br&gt;po.sync_with_ibkr(gw.get_positions())" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="275" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_a4" value="register on_error(_on_ibkr_error)&lt;br&gt;init_trade_log(); init_signal_log()&lt;br&gt;on_fill(make_fill_handler); on_fill(_on_fill)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="355" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wz_a5" value="open_trades = {}&lt;br&gt;live_bars = {sym: deque(maxlen=12) for sym in ALL_TICKERS}&lt;br&gt;pending_closes = set() + threading.Lock()&lt;br&gt;subscribed_sessions = set()&lt;br&gt;on_realtime_bar(_on_realtime_bar)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="450" width="440" height="95" as="geometry" />
        </mxCell>
        <mxCell id="wz_a6" value="config = importlib.import_module(CONFIG_MODULE)&lt;br&gt;tf_seconds = timeframe_to_seconds(TIMEFRAME)&lt;br&gt;last_fetch / closed_overnight_on &#8212; one slot &lt;i&gt;per session&lt;/i&gt;&lt;br&gt;last_processed_candle &#8212; one slot per ticker" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="565" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wz_a7" value="for s in ACTIVE_SESSIONS, for sym in s.tickers:&lt;br&gt;&#160;&#160;contracts[sym] = make_stock_contract(sym, s.exchange, s.currency)&lt;br&gt;&#160;&#160;+ primaryExchange when the session sets one (non-US)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="665" width="440" height="75" as="geometry" />
        </mxCell>

        <!-- ================= LANE A: while True ================= -->
        <mxCell id="wz_loopOuter" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="775" width="850" height="1835" as="geometry" />
        </mxCell>
        <mxCell id="wz_loopOuter_lbl" value="loop   [while True]" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;whiteSpace=nowrap;spacingLeft=4;spacingRight=4;" vertex="1" parent="1">
          <mxGeometry x="64" y="771" width="140" height="18" as="geometry" />
        </mxCell>
        <mxCell id="wz_a8" value="time.sleep(CHECK_INTERVAL)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="240" y="800" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="wz_a9" value="ensure_connected()" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="240" y="865" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="wz_d2" value="reconnected?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="925" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_abreak" value="log &#8216;Lost connection&#8217;&lt;br&gt;break" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="180" y="925" width="110" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_a10" value="drain pending_closes (snapshot under the lock)&lt;br&gt;for symbol in to_close: gw.close_position(contracts[symbol])" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="1000" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wz_a11" value="now = time.time()" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="290" y="1080" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- ================= LANE A: per-session sweep ================= -->
        <mxCell id="wz_loopSess" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="90" y="1145" width="800" height="1425" as="geometry" />
        </mxCell>
        <mxCell id="wz_loopSess_lbl" value="loop   [for session in ACTIVE_SESSIONS]  &#8212; each session independent, overlaps allowed" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;whiteSpace=nowrap;spacingLeft=4;spacingRight=4;fontColor=#6c3483;" vertex="1" parent="1">
          <mxGeometry x="94" y="1141" width="560" height="18" as="geometry" />
        </mxCell>
        <mxCell id="wz_s1" value="phase = session_phase(session, now, tf_seconds)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="1170" width="380" height="45" as="geometry" />
        </mxCell>
        <mxCell id="wz_d3" value="phase?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="1235" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- closed branch -->
        <mxCell id="wz_s2" value="unsubscribe_session(session)&lt;br&gt;&#8212; drop its market-data lines" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="1170" width="250" height="55" as="geometry" />
        </mxCell>

        <!-- flatten branch -->
        <mxCell id="wz_d4" value="already flattened&lt;br&gt;this session today?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="620" y="1255" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wz_s3" value="close_positions(gw, symbols=session.tickers)&lt;br&gt;closed_overnight_on[session.name] = today&lt;br&gt;pending_closes &#8722;= session.tickers&lt;br&gt;&lt;i&gt;only this session's symbols &#8212; others keep trading&lt;/i&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="1350" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="wz_s4" value="unsubscribe_session(session)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="640" y="1460" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="wz_x1" value="next&lt;br&gt;session" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="718" y="1540" width="54" height="40" as="geometry" />
        </mxCell>

        <!-- warmup / trading / wind_down branch -->
        <mxCell id="wz_s5" value="subscribe_session(session)&lt;br&gt;&#8212; live 5s bars, only while this session is open" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="1330" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_d5" value="now &#8722; last_fetch[session.name]&lt;br&gt;&#8805; fetch_interval?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="200" y="1405" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wz_s6" value="entries_allowed = (phase == 'trading')&lt;br&gt;positions = gw.get_positions()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="1500" width="340" height="55" as="geometry" />
        </mxCell>

        <!-- ================= LANE A: per-symbol loop ================= -->
        <mxCell id="wz_loopSym" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="120" y="1580" width="560" height="855" as="geometry" />
        </mxCell>
        <mxCell id="wz_loopSym_lbl" value="loop   [for symbol in session.tickers]  &#8212; wrapped in try/except ConnectionError" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;whiteSpace=nowrap;spacingLeft=4;spacingRight=4;" vertex="1" parent="1">
          <mxGeometry x="124" y="1576" width="520" height="18" as="geometry" />
        </mxCell>
        <mxCell id="wz_t1" value="params = params_lookup.get_params(config.PARAMS, ..., symbol, TIMEFRAME)&lt;br&gt;vol_len (shared by both directions);&#160;&#160;duration = vol_len &#215; tf_seconds&lt;br&gt;long_params / short_params &#8212; each *_long/*_short key falling back&lt;br&gt;to the plain one (USE_DIRECTIONAL_PARAMS)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="145" y="1605" width="510" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wz_t2" value="df = fetch_data_from_IBKR(gw, contracts[symbol], duration, TIMEFRAME, use_rth=True)&lt;br&gt;&lt;i&gt;takes the prebuilt contract, so bars and orders use the same definition&lt;/i&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="145" y="1700" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wz_d6" value="df empty, or this candle&lt;br&gt;already processed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="230" y="1775" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wz_t3" value="df = df.tail(vol_len);&#160;&#160;last_price = df['Close'].iloc[-1]&lt;br&gt;po.update_current_price(symbol, last_price)&lt;br&gt;signal, _, debug, flags = check_vol_price_body_dir(df, long_params, short_params)&lt;br&gt;log_signal_csv(SIGNAL_LOG, symbol, signal, debug, flags)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="145" y="1855" width="510" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wz_d7" value="LIVE_TRADING &lt;b&gt;and&lt;/b&gt; entries_allowed?&lt;br&gt;&lt;i&gt;(false in warmup / wind_down &#8212; poll &amp; manage only)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="185" y="1955" width="430" height="75" as="geometry" />
        </mxCell>
        <mxCell id="wz_t4" value="p = long_params if signal == 'BUY' else short_params&lt;br&gt;trail_stop_used, take_profit_used = p['trail_stop_pct'], p['take_profit_pct']&lt;br&gt;quantity = shares_for_cash(session.cash_per_trade, last_price)&lt;br&gt;&lt;i&gt;sized by money in the session's currency, not a fixed share count&lt;/i&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="145" y="2050" width="510" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wz_d8" value="quantity &#8805; 1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="290" y="2150" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wz_t5" value="execute_trade(gw, symbol, signal, contracts[symbol],&lt;br&gt;quantity, trail_stop_used, FILL_TIMEOUT, positions)&lt;br&gt;&#8594; entry + broker-side TRAIL" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="160" y="2225" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wz_d9" value="filled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="2310" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wz_t6" value="open_trades[symbol] = {contract, direction, entry_price, entry_time,&lt;br&gt;entry_order_id, trail_stop_loss, extreme, take_profit_pct, bars_since_check}&lt;br&gt;last_processed_candle[symbol] = candle_time" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="145" y="2375" width="510" height="75" as="geometry" />
        </mxCell>

        <mxCell id="wz_s7" value="print positions;&#160;&#160;po.sync_with_ibkr(gw.get_positions())&lt;br&gt;last_fetch[session.name] = now" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="2470" width="380" height="60" as="geometry" />
        </mxCell>

        <!-- ================= LANE A: shutdown ================= -->
        <mxCell id="wz_a12" value="finally:&lt;br&gt;for req_id in realtime_req_id_by_symbol.values(): stop_realtime_bars(req_id)&lt;br&gt;gw.disconnect()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="2640" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wz_end2_o" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="388" y="2740" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="wz_end2_i" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="394" y="2746" width="12" height="12" as="geometry" />
        </mxCell>

        <!-- ================= LANE A edges ================= -->
        <mxCell id="wz_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_start" target="wz_a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a1" target="wz_d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e3" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_d1" target="wz_a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a2" target="wz_end1_o"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e5" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_d1" target="wz_a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a3" target="wz_a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a4" target="wz_a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a5" target="wz_a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a6" target="wz_a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a7" target="wz_a8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a8" target="wz_a9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a9" target="wz_d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e13" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_d2" target="wz_abreak"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e14" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_d2" target="wz_a10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a10" target="wz_a11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_a11" target="wz_s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_s1" target="wz_d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e18" value="[closed]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;" edge="1" parent="1" source="wz_d3" target="wz_s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e19" value="[flatten]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_d3" target="wz_d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e20" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_d4" target="wz_s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_s3" target="wz_s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e22" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="wz_d4" target="wz_s4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="1290" /><mxPoint x="885" y="1482" /></Array></mxGeometry></mxCell>
        <mxCell id="wz_e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_s4" target="wz_x1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wz_s2" target="wz_d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e25" value="[warmup | trading | wind_down]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="wz_d3" target="wz_s5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="1265" /><mxPoint x="160" y="1310" /><mxPoint x="350" y="1310" /></Array></mxGeometry></mxCell>
        <mxCell id="wz_e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_s5" target="wz_d5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e27" value="[no] next session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;" edge="1" parent="1" source="wz_d5" target="wz_x1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="1440" /><mxPoint x="560" y="1560" /></Array></mxGeometry></mxCell>
        <mxCell id="wz_e28" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_d5" target="wz_s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_s6" target="wz_t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_t1" target="wz_t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wz_t2" target="wz_d6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wz_e32" value="[yes] next symbol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wz_d6" target="wz_t1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="1805" /><mxPoint x="135" y="1645" /></Array></mxGeometry></mxCell>
        <mxCell id="wz_e33" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wz_d6" target="wz_t3"><mxGeometry relative="1" as="geometry" /></mxCell>
