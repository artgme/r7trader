        <mxCell id="rj_a7" value="for sym in SYMBOLS:&lt;br&gt;  req_id = start_realtime_bars(contracts[sym])&lt;br&gt;  symbol_by_req_id[req_id] = sym" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
