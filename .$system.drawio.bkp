        <mxCell id="rj_a6" value="config = importlib.import_module(CONFIG_MODULE)&lt;br&gt;contracts = {sym: make_stock_contract(sym) for sym in SYMBOLS}" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
